<Window x:Class="TodoList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TodoList"
        Title="Todo List" Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.Resources>
        <local:PriorityColorConverter x:Key="PriorityColorConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Row 0: Priority + Task input + Add + Settings -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PriorityCombo" Grid.Column="0" SelectedIndex="1" Margin="0,0,8,0" Width="80" VerticalContentAlignment="Center">
                <ComboBoxItem Tag="1">1 - High</ComboBoxItem>
                <ComboBoxItem Tag="2">2 - Med</ComboBoxItem>
                <ComboBoxItem Tag="3">3 - Low</ComboBoxItem>
            </ComboBox>
            <TextBox x:Name="TodoInput" Grid.Column="1" Margin="0,0,8,0" Padding="5" VerticalContentAlignment="Center" KeyDown="TodoInput_KeyDown"/>
            <Button x:Name="AddButton" Grid.Column="2" Content="Add" Width="50" Padding="5" Click="AddButton_Click" Margin="0,0,6,0"/>
            <Button Grid.Column="3" Content="⚙" Width="32" FontSize="15" Padding="0"
                    ToolTip="Settings" Click="SettingsButton_Click"/>
        </Grid>

        <!-- Row 1: Duration input (hours + minutes) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Duration:" VerticalAlignment="Center" Foreground="Gray" FontSize="12" Margin="0,0,10,0"/>

            <!-- Hours stepper -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="−" BorderThickness="0" Background="Transparent"
                            FontSize="14" FontWeight="Bold" Foreground="#555"
                            Click="HourDown_Click" Padding="0"/>
                    <TextBox x:Name="HourInput" Grid.Column="1" Text="0" TextAlignment="Center"
                             BorderThickness="0" VerticalContentAlignment="Center"
                             FontSize="13" FontWeight="SemiBold" IsReadOnly="True" Background="Transparent"/>
                    <Button Grid.Column="2" Content="+" BorderThickness="0" Background="Transparent"
                            FontSize="14" FontWeight="Bold" Foreground="#555"
                            Click="HourUp_Click" Padding="0"/>
                </Grid>
            </Border>
            <TextBlock Text="h" VerticalAlignment="Center" FontSize="12" Foreground="#777" Margin="0,0,10,0"/>

            <!-- Minutes stepper (0, 15, 30, 45) -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="−" BorderThickness="0" Background="Transparent"
                            FontSize="14" FontWeight="Bold" Foreground="#555"
                            Click="MinDown_Click" Padding="0"/>
                    <TextBox x:Name="MinInput" Grid.Column="1" Text="00" TextAlignment="Center"
                             BorderThickness="0" VerticalContentAlignment="Center"
                             FontSize="13" FontWeight="SemiBold" IsReadOnly="True" Background="Transparent"/>
                    <Button Grid.Column="2" Content="+" BorderThickness="0" Background="Transparent"
                            FontSize="14" FontWeight="Bold" Foreground="#555"
                            Click="MinUp_Click" Padding="0"/>
                </Grid>
            </Border>
            <TextBlock Text="m" VerticalAlignment="Center" FontSize="12" Foreground="#777"/>
        </StackPanel>

        <!-- Row 2: Filter checkbox -->
        <CheckBox x:Name="TodayOnlyCheck" Grid.Row="2" Content="Show today's tasks only" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,0,10"/>
        
        <!-- Row 3: Task list -->
        <ListBox x:Name="TodoListBox" Grid.Row="3" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="TaskBorder" Padding="10" Margin="0,4" CornerRadius="5" Background="{Binding Priority, Converter={StaticResource PriorityColorConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TodoText" Text="{Binding Text}" Grid.Column="0"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <Button x:Name="StartButton" Content="▶" Grid.Column="1" Width="25" Height="25"
                                        Foreground="DarkBlue" FontWeight="Bold" Margin="0,0,4,0"
                                        Click="StartButton_Click" Tag="{Binding}" ToolTip="Start countdown"/>
                                <Button x:Name="TickButton" Content="✓" Grid.Column="2" Width="25" Height="25"
                                        Foreground="Green" FontWeight="Bold" Margin="0,0,4,0"
                                        Click="MarkDoneButton_Click" Tag="{Binding}" ToolTip="Mark done"/>
                                <Button x:Name="DeleteButton" Content="✕" Grid.Column="3" Width="25" Height="25"
                                        Foreground="Red" FontWeight="Bold"
                                        Click="DeleteButton_Click" Tag="{Binding}" Visibility="Collapsed" ToolTip="Delete"/>
                            </Grid>
                            <TextBlock x:Name="DurationText" Grid.Row="1"
                                       Text="{Binding DurationLabel}"
                                       FontSize="11" Foreground="#555" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <!-- Already running — disable start button -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="StartButton" Property="IsEnabled" Value="False"/>
                            <Setter TargetName="StartButton" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="StartButton" Property="ToolTip" Value="Already running"/>
                        </DataTrigger>
                        <!-- Done state -->
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="TaskBorder" Property="Background" Value="#E0E0E0"/>
                            <Setter TargetName="TodoText" Property="TextDecorations" Value="Strikethrough"/>
                            <Setter TargetName="TodoText" Property="Foreground" Value="Gray"/>
                            <Setter TargetName="DurationText" Property="Foreground" Value="#AAA"/>
                            <Setter TargetName="StartButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="TickButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- Hide duration label if no duration set -->
                        <DataTrigger Binding="{Binding DurationLabel}" Value="">
                            <Setter TargetName="DurationText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
