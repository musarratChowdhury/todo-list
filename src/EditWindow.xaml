<Window x:Class="TodoList.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="checkmark.ico"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Task text -->
        <TextBlock Grid.Row="0" Text="Task" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
        <TextBox x:Name="EditTextInput" Grid.Row="1" Padding="6" FontSize="13" Margin="0,0,0,16"
                 TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Center"/>

        <!-- Priority -->
        <TextBlock Grid.Row="2" Text="Priority" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
        <ComboBox x:Name="EditPriorityCombo" Grid.Row="3" Margin="0,0,0,16" Padding="4" FontSize="13">
            <ComboBoxItem Tag="1">1 - High</ComboBoxItem>
            <ComboBoxItem Tag="2">2 - Med</ComboBoxItem>
            <ComboBoxItem Tag="3">3 - Low</ComboBoxItem>
        </ComboBox>

        <!-- Duration -->
        <TextBlock Grid.Row="4" Text="Duration" FontSize="12" Foreground="#666" Margin="0,0,0,6"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
            <!-- Hours stepper -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="−" BorderThickness="0" Background="Transparent"
                            FontSize="14" FontWeight="Bold" Foreground="#555"
                            Click="HourDown_Click" Padding="0"/>
                    <TextBox x:Name="HourInput" Grid.Column="1" Text="0" TextAlignment="Center"
                             BorderThickness="0" VerticalContentAlignment="Center"
                             FontSize="13" FontWeight="SemiBold" IsReadOnly="True" Background="Transparent"/>
                    <Button Grid.Column="2" Content="+" BorderThickness="0" Background="Transparent"
                            FontSize="14" FontWeight="Bold" Foreground="#555"
                            Click="HourUp_Click" Padding="0"/>
                </Grid>
            </Border>
            <TextBlock Text="h" VerticalAlignment="Center" FontSize="12" Foreground="#777" Margin="0,0,10,0"/>

            <!-- Minutes stepper (0, 15, 30, 45) -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="−" BorderThickness="0" Background="Transparent"
                            FontSize="14" FontWeight="Bold" Foreground="#555"
                            Click="MinDown_Click" Padding="0"/>
                    <TextBox x:Name="MinInput" Grid.Column="1" Text="00" TextAlignment="Center"
                             BorderThickness="0" VerticalContentAlignment="Center"
                             FontSize="13" FontWeight="SemiBold" IsReadOnly="True" Background="Transparent"/>
                    <Button Grid.Column="2" Content="+" BorderThickness="0" Background="Transparent"
                            FontSize="14" FontWeight="Bold" Foreground="#555"
                            Click="MinUp_Click" Padding="0"/>
                </Grid>
            </Border>
            <TextBlock Text="m" VerticalAlignment="Center" FontSize="12" Foreground="#777"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Padding="0,6" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Save" Width="80" Padding="0,6" Click="Save_Click" IsDefault="True"
                    Background="#0078D4" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
