<Window x:Class="TodoList.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Countdown" Height="300" Width="380"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Icon="checkmark.ico"
        ResizeMode="CanMinimize">
    <Grid Background="#1E1E2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Task name -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TaskNameText" Text="" FontSize="16" Foreground="#CDD6F4"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20,0"/>
            <TextBlock x:Name="CountdownText" Text="00:00:00" FontSize="52" Foreground="#A6E3A1"
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="Consolas"/>
            <TextBlock x:Name="StatusText" Text="Running" FontSize="13" Foreground="#6C7086"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Button x:Name="PauseButton" Content="⏸ Pause" Width="100" Height="34" Margin="6,0"
                    Background="#313244" Foreground="White" BorderThickness="0"
                    Click="PauseButton_Click" FontSize="13"/>
            <Button x:Name="ResetButton" Content="↺ Reset" Width="100" Height="34" Margin="6,0"
                    Background="#313244" Foreground="White" BorderThickness="0"
                    Click="ResetButton_Click" FontSize="13"/>
        </StackPanel>

        <!-- Mini / Dock button -->
        <Button Grid.Row="2" Content="⬇ Minimize to Dock" Height="30" Margin="20,0,20,14"
                Background="#45475A" Foreground="White" BorderThickness="0"
                Click="MiniModeButton_Click" FontSize="12"/>
    </Grid>
</Window>
